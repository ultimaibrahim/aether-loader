<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Aether Blueprint: a plain BepInEx plugin built on Aether Nano. It runs with Aether or with BepInEx
    alone; the only thing it needs next to it is Aether.Nano.dll.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Aether.Mods.Blueprint</AssemblyName>
    <RootNamespace>Aether.Mods.Blueprint</RootNamespace>
    <Nullable>disable</Nullable>
    <Version>1.1.1</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Aether.Nano\Aether.Nano.csproj" Private="false" />
  </ItemGroup>
  <Import Project="..\..\GameReferences.props" />
</Project>
