<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Aether.Installer.App.MonitorWindow"
        Title="Aether Monitor" Icon="/Assets/aether.png" Width="860" Height="580" MinWidth="620" MinHeight="400"
        WindowStartupLocation="CenterScreen">
  <Grid RowDefinitions="Auto,Auto,*" Margin="16">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
      <StackPanel Grid.Column="0">
        <TextBlock Text="Aether Monitor" FontSize="24" Classes="display" />
        <TextBlock x:Name="GameLabel" Opacity="0.65" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button x:Name="AddModButton" Content="Add mod…" Classes="accent" />
        <Button x:Name="RefreshButton" Content="Refresh" />
      </StackPanel>
    </Grid>

    <Border x:Name="UpdateBanner" Grid.Row="1" IsVisible="False" Margin="0,0,0,10" Padding="12,8" CornerRadius="6"
            BorderBrush="{DynamicResource SystemAccentColor}" BorderThickness="1">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock x:Name="UpdateText" VerticalAlignment="Center" TextWrapping="Wrap" />
        <Button x:Name="UpdateButton" Grid.Column="1" Content="Update Aether" Classes="accent" Margin="12,0,0,0" />
      </Grid>
    </Border>

    <TabControl Grid.Row="2">
      <TabItem Header="Status">
        <ListBox x:Name="StatusLines" Background="Transparent" />
      </TabItem>
      <TabItem Header="Mods">
        <ListBox x:Name="ModLines" Background="Transparent" />
      </TabItem>
      <TabItem x:Name="CatalogTab" Header="Catalog">
        <Grid RowDefinitions="*,Auto">
          <ListBox x:Name="CatalogLines" Grid.Row="0" Background="Transparent" />
          <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*" Margin="0,8,0,0">
            <Button x:Name="CatalogInstall" Grid.Column="0" Content="Install / update selected" Classes="accent" />
            <Button x:Name="CatalogRefresh" Grid.Column="1" Content="Refresh catalog" Margin="8,0,0,0" />
            <TextBlock x:Name="CatalogStatus" Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" Opacity="0.7" TextWrapping="Wrap" />
          </Grid>
        </Grid>
      </TabItem>
      <TabItem Header="Crashes &amp; logs">
        <Grid ColumnDefinitions="260,*" RowDefinitions="*,Auto">
          <ListBox x:Name="LogFiles" Grid.Column="0" Grid.Row="0" Background="Transparent" />
          <TextBox x:Name="LogText" Grid.Column="1" Grid.Row="0" IsReadOnly="True" AcceptsReturn="True"
                   Classes="mono" FontSize="12" Margin="8,0,0,0" TextWrapping="NoWrap" />
          <StackPanel Grid.Column="0" Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
            <Button x:Name="OpenLogs" Content="Open logs folder" />
            <Button x:Name="OpenMods" Content="Open mods folder" />
          </StackPanel>
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>
</Window>
