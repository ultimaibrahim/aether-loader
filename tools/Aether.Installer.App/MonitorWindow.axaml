<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Aether.Installer.App.MonitorWindow"
        Title="Aether Monitor" Icon="/Assets/aether.png" Width="1120" Height="740" MinWidth="880" MinHeight="560"
        WindowStartupLocation="CenterScreen" DragDrop.AllowDrop="True">
  <Window.Styles>
    <!-- Buttons drawn in Aether's language: ember for the one main action, ink for "do all", outline ember for an update, paper for done. -->
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="RenderTransform" Value="none" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button:pressed">
      <Setter Property="RenderTransform" Value="scale(0.97)" />
    </Style>
    <Style Selector="Button.primary /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#C2500A" />
      <Setter Property="BorderBrush" Value="#C2500A" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#A84208" />
      <Setter Property="BorderBrush" Value="#A84208" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.update /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#C2500A" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="Foreground" Value="#C2500A" />
    </Style>
    <Style Selector="Button.update:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#FBE9DD" />
      <Setter Property="BorderBrush" Value="#A84208" />
      <Setter Property="Foreground" Value="#A84208" />
    </Style>
    <Style Selector="Button.done /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#F2EDE6" />
      <Setter Property="BorderBrush" Value="#E4DDD3" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="#3D342C" />
    </Style>
    <Style Selector="Button.busy /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#FBE9DD" />
      <Setter Property="BorderBrush" Value="#E7A27A" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="Foreground" Value="#A84208" />
    </Style>
    <Style Selector="Button.ink /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#1A1410" />
      <Setter Property="Foreground" Value="#FBFAF8" />
    </Style>
    <Style Selector="Button.ink:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#3D342C" />
      <Setter Property="Foreground" Value="#FBFAF8" />
    </Style>
    <Style Selector="Button.quiet /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#E4DDD3" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="#1A1410" />
    </Style>
    <Style Selector="Button.quiet:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#F2EDE6" />
      <Setter Property="BorderBrush" Value="#C9BEAE" />
    </Style>
    <Style Selector="Button.chip /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#E4DDD3" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="#1A1410" />
    </Style>
    <Style Selector="Button.chip.on /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#1A1410" />
      <Setter Property="BorderBrush" Value="#1A1410" />
      <Setter Property="Foreground" Value="#FBFAF8" />
    </Style>
    <Style Selector="Button.chip">
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="Height" Value="38" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.nav, Button.bare">
      <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style Selector="Button.nav /template/ ContentPresenter#PART_ContentPresenter, Button.bare /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#F2EDE6" />
    </Style>
    <Style Selector="Button.bare:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#E4DDD3" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.18" />
          <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.18" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.card:pointerover">
      <Setter Property="BorderBrush" Value="#C9BEAE" />
      <Setter Property="BoxShadow" Value="0 10 28 -18 #731A1410" />
    </Style>
    <Style Selector="Border.card.selected">
      <Setter Property="BorderBrush" Value="#C2500A" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="ScrollViewer">
      <Setter Property="AllowAutoHide" Value="True" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*">
    <!-- title bar -->
    <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E4DDD3" BorderThickness="0,0,0,1" Padding="18,0" Height="56">
      <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto" VerticalAlignment="Center">
        <ContentControl x:Name="LogoHost" Grid.Column="0" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Classes="display" FontSize="22" Margin="12,0,0,0" VerticalAlignment="Center">
          <Run Text="aether " /><Run Text="monitor" Foreground="#6B6157" />
        </TextBlock>
        <TextBlock x:Name="GameLabel" Grid.Column="2" Classes="mono" FontSize="11" Foreground="#6B6157" Margin="14,4,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="420" />
        <Button x:Name="LangButton" Grid.Column="4" Classes="quiet" Padding="10,6" Margin="0,0,8,0" FontWeight="Normal" />
        <Button x:Name="RefreshButton" Grid.Column="5" Classes="quiet" Padding="12,6" FontWeight="Normal" />
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="208,*">
      <!-- sections -->
      <Border Grid.Column="0" BorderBrush="#E4DDD3" BorderThickness="0,0,1,0" Padding="10,16">
        <Grid RowDefinitions="Auto,*,Auto">
          <StackPanel x:Name="NavPanel" Grid.Row="0" Spacing="4" />
          <Border x:Name="DropZone" Grid.Row="2" BorderBrush="#C9BEAE" BorderThickness="1.5" CornerRadius="10" Padding="12,14" Cursor="Hand">
            <StackPanel Spacing="6" HorizontalAlignment="Center">
              <ContentControl x:Name="DropCube" HorizontalAlignment="Center" />
              <TextBlock x:Name="DropText" FontSize="12" Foreground="#6B6157" TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <Grid Grid.Column="1" RowDefinitions="Auto,*">
        <Border x:Name="UpdateBanner" Grid.Row="0" IsVisible="False" Margin="26,18,26,0" Padding="14,10" CornerRadius="10"
                Background="#FBE9DD" BorderBrush="#E7A27A" BorderThickness="1">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <ContentControl x:Name="UpdateSign" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBlock x:Name="UpdateText" Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap" />
            <Button x:Name="UpdateButton" Grid.Column="2" Classes="primary" Margin="12,0,0,0" Padding="14,8" />
          </Grid>
        </Border>

        <!-- Status -->
        <Grid x:Name="StatusPanel" Grid.Row="1" Margin="26,22,26,18" RowDefinitions="Auto,*">
          <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock x:Name="StatusTitle" Classes="display" FontSize="36" />
            <TextBlock x:Name="StatusSummary" FontSize="13" Foreground="#6B6157" Margin="0,6,0,0" />
          </StackPanel>
          <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E4DDD3" BorderThickness="1" CornerRadius="12">
            <ScrollViewer><StackPanel x:Name="StatusHost" Margin="6" /></ScrollViewer>
          </Border>
        </Grid>

        <!-- My mods -->
        <Grid x:Name="ModsPanel" Grid.Row="1" Margin="26,22,26,18" RowDefinitions="Auto,*,Auto" IsVisible="False">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock x:Name="ModsTitle" Classes="display" FontSize="36" />
              <TextBlock x:Name="ModsSummary" FontSize="13" Foreground="#6B6157" Margin="0,6,0,0" />
            </StackPanel>
            <TextBlock x:Name="ModsHint" Grid.Column="1" FontSize="12" Foreground="#6B6157" MaxWidth="300" TextAlignment="Right" TextWrapping="Wrap" VerticalAlignment="Bottom" />
          </Grid>
          <Border Grid.Row="1" Background="#FBFAF8" BorderBrush="#E4DDD3" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
            <Grid RowDefinitions="Auto,*">
              <Border Grid.Row="0" Background="#F6F2EC" BorderBrush="#E4DDD3" BorderThickness="0,0,0,1" Padding="16,9">
                <Grid x:Name="ModsHeader" ColumnDefinitions="56,*,170,110,76" />
              </Border>
              <ScrollViewer Grid.Row="1"><StackPanel x:Name="ModsHost" /></ScrollViewer>
            </Grid>
          </Border>
          <StackPanel x:Name="ModsFoot" Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0" />
        </Grid>

        <!-- Catalog -->
        <Grid x:Name="CatalogPanel" Grid.Row="1" Margin="26,22,26,18" RowDefinitions="Auto,Auto,*" IsVisible="False">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock x:Name="CatalogTitle" Classes="display" FontSize="36" />
              <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                <ContentControl x:Name="CatalogSign" VerticalAlignment="Center" />
                <TextBlock x:Name="CatalogStatus" FontSize="13" Foreground="#6B6157" VerticalAlignment="Center" TextWrapping="Wrap" />
              </StackPanel>
            </StackPanel>
            <Button x:Name="UpdateAllButton" Grid.Column="1" Classes="ink" Padding="16,11" VerticalAlignment="Bottom" />
          </Grid>
          <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,12">
            <TextBox x:Name="SearchBox" Grid.Column="0" Height="38" VerticalContentAlignment="Center" MinWidth="200" />
            <WrapPanel x:Name="ChipsPanel" Grid.Column="1" Margin="8,0,0,0" />
            <Border Grid.Column="2" Margin="8,0,0,0" BorderBrush="#E4DDD3" BorderThickness="1" CornerRadius="8" Background="#FFFFFF" Padding="2">
              <StackPanel Orientation="Horizontal">
                <Button x:Name="ViewCards" Classes="chip" Height="32" Padding="10,0" BorderThickness="0" />
                <Button x:Name="ViewList" Classes="chip" Height="32" Padding="10,0" BorderThickness="0" />
              </StackPanel>
            </Border>
          </Grid>
          <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
            <ScrollViewer Grid.Column="0"><ContentControl x:Name="CatalogHost" /></ScrollViewer>
            <Border x:Name="Aside" Grid.Column="1" Width="340" Margin="12,0,0,0" IsVisible="False" Background="#F6F2EC"
                    BorderBrush="#E4DDD3" BorderThickness="1" CornerRadius="12" Padding="20">
              <ScrollViewer><StackPanel x:Name="AsideHost" Spacing="12" Margin="0,0,14,0" /></ScrollViewer>
            </Border>
          </Grid>
        </Grid>

        <!-- Modding Forum & Guide -->
        <Grid x:Name="ForumPanel" Grid.Row="1" Margin="26,22,26,18" RowDefinitions="Auto,Auto,*,Auto" IsVisible="False">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock x:Name="ForumTitle" Classes="display" FontSize="36" />
              <TextBlock x:Name="ForumSummary" FontSize="13" Foreground="#6B6157" Margin="0,6,0,0" TextWrapping="Wrap" MaxWidth="620" />
            </StackPanel>
            <Button x:Name="OpenForumWeb" Grid.Column="1" Classes="primary" Padding="16,11" VerticalAlignment="Bottom" />
          </Grid>
          <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <TextBox x:Name="ForumSearchBox" Grid.Column="0" Height="38" VerticalContentAlignment="Center" MinWidth="200" />
            <WrapPanel x:Name="ForumChipsPanel" Grid.Column="1" Margin="8,0,0,0" />
          </Grid>
          <Border Grid.Row="2" Background="#FBFAF8" BorderBrush="#E4DDD3" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
            <ScrollViewer><StackPanel x:Name="ForumHost" Spacing="8" Margin="12" /></ScrollViewer>
          </Border>
          <Border Grid.Row="3" Background="#F6F2EC" BorderBrush="#E4DDD3" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,10,0,0">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock x:Name="ForumCliHint" Grid.Column="0" Classes="mono" FontSize="11.5" Foreground="#1A1410" VerticalAlignment="Center" TextWrapping="Wrap" />
              <Button x:Name="OpenForumAsk" Grid.Column="1" Classes="quiet" Padding="12,7" Margin="10,0,0,0" />
            </Grid>
          </Border>
        </Grid>

        <!-- Problems and logs -->
        <Grid x:Name="LogsPanel" Grid.Row="1" Margin="26,22,26,18" RowDefinitions="Auto,*,Auto" IsVisible="False">
          <TextBlock x:Name="LogsTitle" Grid.Row="0" Classes="display" FontSize="36" Margin="0,0,0,14" />
          <Grid Grid.Row="1" ColumnDefinitions="280,*">
            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E4DDD3" BorderThickness="1" CornerRadius="12">
              <ListBox x:Name="LogFiles" Background="Transparent" />
            </Border>
            <TextBox x:Name="LogText" Grid.Column="1" IsReadOnly="True" AcceptsReturn="True" Classes="mono" FontSize="12" Margin="10,0,0,0" TextWrapping="NoWrap" />
          </Grid>
          <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
            <Button x:Name="OpenLogs" Classes="quiet" Padding="12,8" />
            <Button x:Name="OpenMods" Classes="quiet" Padding="12,8" />
          </StackPanel>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</Window>
