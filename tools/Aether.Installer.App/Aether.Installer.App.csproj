<Project Sdk="Microsoft.NET.Sdk">
  <!-- The graphical installer: a thin Avalonia window over Aether.Installer (the same code the CLI uses). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>aether-installer</AssemblyName>
    <RootNamespace>Aether.Installer.App</RootNamespace>
    <Version>$(AetherVersion)</Version>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\aether.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Release publish (dotnet publish -r <rid>): "full" = one self-contained, trimmed, compressed file (needs nothing installed). -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != '' And '$(Flavor)' != 'light'">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!-- "light" (-p:Flavor=light): uses the .NET 9 runtime installed on the machine, so the download is a fraction of the size. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != '' And '$(Flavor)' == 'light'">
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\aether.png" />
    <AvaloniaResource Include="Assets\aether-light.png" />
    <!-- The brand fonts, the same files Aether Nano embeds for the game (OFL; licences in src/Aether.Nano/Brand). -->
    <AvaloniaResource Include="..\..\src\Aether.Nano\Brand\*.ttf" Link="Assets\Fonts\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.5" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Aether.Installer\Aether.Installer.csproj" />
  </ItemGroup>
</Project>
