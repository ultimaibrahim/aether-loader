<Project Sdk="Microsoft.NET.Sdk">

  <!-- A mod that needs no Aether assembly: BepInEx + Unity only, with Aether Nano compiled in. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>NanoSample</AssemblyName>
    <RootNamespace>NanoSample</RootNamespace>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <Import Project="..\..\src\Aether.Nano.Source\AetherNano.props" />

  <ItemGroup Condition="Exists('$(BepInExCorePath)/BepInEx.dll')">
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCorePath)/BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(GameManagedPath)/UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameManagedPath)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
